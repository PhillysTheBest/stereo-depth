{
  "name": "stereo-depth-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "react": "18",
    "react-dom": "18",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "6",
    "vitest": "3"
  },
  "pnpm": {
    "overrides": {
      "@types/three": "$@types/three"
    }
  }
}
